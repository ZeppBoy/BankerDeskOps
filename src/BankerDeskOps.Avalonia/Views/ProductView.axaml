<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BankerDeskOps.Avalonia.Views.ProductView">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Product Management" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Create Product Form -->
        <Border Grid.Row="1" Background="#f9f9f9" BorderBrush="#dee2e6" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <!-- Row 1: Name, Description, Active -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Product Name:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox   Grid.Column="1" Text="{Binding Name}" Margin="0,0,10,0" Padding="5"/>

                    <TextBlock Grid.Column="2" Text="Description:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox   Grid.Column="3" Text="{Binding Description}" Margin="0,0,10,0" Padding="5"/>

                    <TextBlock Grid.Column="4" Text="Active:" VerticalAlignment="Center"/>
                    <CheckBox  Grid.Column="5" IsChecked="{Binding IsActive}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </Grid>

                <!-- Row 2: Term, Min Amount, Max Amount -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Term (months):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox   Grid.Column="1" Text="{Binding Term}" Margin="0,0,10,0" Padding="5"/>

                    <TextBlock Grid.Column="2" Text="Min Amount:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox   Grid.Column="3" Text="{Binding MinAmount}" Margin="0,0,10,0" Padding="5"/>

                    <TextBlock Grid.Column="4" Text="Max Amount:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox   Grid.Column="5" Text="{Binding MaxAmount}" Padding="5"/>
                </Grid>

                <!-- Row 3: Currency -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Currency:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox  Grid.Column="1"
                               ItemsSource="{Binding Currencies}"
                               SelectedItem="{Binding SelectedCurrencyForProduct}"
                               Padding="5" MinWidth="150">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Code}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Save"         Command="{Binding SaveProductCommand}"
                    Height="35" Padding="15,5" Background="#28a745" Foreground="White" Margin="0,0,5,0"/>
            <Button Content="Edit Selected" Command="{Binding EditProductCommand}"
                    Height="35" Padding="15,5" Background="#ffc107" Foreground="Black" Margin="0,0,5,0"/>
            <Button Content="Delete"        Command="{Binding DeleteProductCommand}"
                    Height="35" Padding="15,5" Background="#dc3545" Foreground="White" Margin="0,0,5,0"/>
            <Button Content="Cancel"        Command="{Binding CancelEditCommand}"
                    Height="35" Padding="15,5" Background="#6c757d" Foreground="White" Margin="0,0,5,0"/>
            <Button Content="Refresh"       Command="{Binding LoadProductsCommand}"
                    Height="35" Padding="15,5" Background="#17a2b8" Foreground="White"/>
        </StackPanel>

        <!-- Products DataGrid -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"          Binding="{Binding Id}"           Width="150"/>
                <DataGridTextColumn Header="Name"        Binding="{Binding Name}"         Width="*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}"  Width="*"/>
                <DataGridTextColumn Header="Term"        Binding="{Binding Term}"         Width="60"/>
                <DataGridTextColumn Header="Min Amount"  Binding="{Binding MinAmount, StringFormat={}{0:C2}}" Width="100"/>
                <DataGridTextColumn Header="Max Amount"  Binding="{Binding MaxAmount, StringFormat={}{0:C2}}" Width="100"/>
                <DataGridCheckBoxColumn Header="Active"   Binding="{Binding IsActive}"    Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status / Error Message -->
        <TextBlock Grid.Row="4"
                   Text="{Binding ErrorMessage}"
                   Foreground="#dc3545"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
