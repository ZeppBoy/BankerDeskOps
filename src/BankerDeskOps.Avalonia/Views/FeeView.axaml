<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BankerDeskOps.Avalonia.Views.FeeView">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Fee Management" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Fee Form -->
        <Border Grid.Row="1" Background="#f9f9f9" BorderBrush="#dee2e6" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Product ID:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox   Grid.Column="1" Text="{Binding ProductId}" Margin="0,0,10,0" Padding="5"/>

                <TextBlock Grid.Column="2" Text="Fee Name:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox   Grid.Column="3" Text="{Binding Name}" Margin="0,0,10,0" Padding="5"/>

                <TextBlock Grid.Column="4" Text="Amount:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox   Grid.Column="5" Text="{Binding Amount}" Padding="5"/>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Save"          Command="{Binding SaveFeeCommand}"
                    Height="35" Padding="15,5" Background="#28a745" Foreground="White" Margin="0,0,5,0"/>
            <Button Content="Edit Selected" Command="{Binding EditFeeCommand}"
                    Height="35" Padding="15,5" Background="#007acc" Foreground="White" Margin="0,0,5,0"/>
            <Button Content="Delete"        Command="{Binding DeleteFeeCommand}"
                    Height="35" Padding="15,5" Background="#dc3545" Foreground="White" Margin="0,0,5,0"/>
            <Button Content="Cancel"        Command="{Binding CancelEditCommand}"
                    Height="35" Padding="15,5" Background="#6c757d" Foreground="White" Margin="0,0,5,0"/>
            <Button Content="Load All"      Command="{Binding LoadFeesCommand}"
                    Height="35" Padding="15,5" Background="#17a2b8" Foreground="White" Margin="0,0,5,0"/>
            <Button Content="By Product"    Command="{Binding LoadFeesByProductCommand}"
                    Height="35" Padding="15,5" Background="#fd7e14" Foreground="White"/>
        </StackPanel>

        <!-- Fees DataGrid -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Fees}"
                  SelectedItem="{Binding SelectedFee}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"         Binding="{Binding Id}"        Width="220"/>
                <DataGridTextColumn Header="Product ID" Binding="{Binding ProductId}" Width="220"/>
                <DataGridTextColumn Header="Name"       Binding="{Binding Name}"      Width="*"/>
                <DataGridTextColumn Header="Amount"     Binding="{Binding Amount, StringFormat={}{0:C}}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status / Error Message -->
        <TextBlock Grid.Row="4"
                   Text="{Binding ErrorMessage}"
                   Foreground="#dc3545"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
