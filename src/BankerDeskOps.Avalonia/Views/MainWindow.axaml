<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BankerDeskOps.Avalonia.Views"
        xmlns:viewmodels="clr-namespace:BankerDeskOps.Avalonia.ViewModels"
        x:Class="BankerDeskOps.Avalonia.Views.MainWindow"
        Title="BankerDeskOps - Banking Operations"
        Height="650" Width="1100"
        MinHeight="500" MinWidth="800">

    <!-- DataTemplates tell ContentControl which UserControl to render for each ViewModel type -->
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type viewmodels:LoansViewModel}">
            <views:LoansView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:RetailAccountsViewModel}">
            <views:RetailAccountsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BankClientsViewModel}">
            <views:BankClientsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:UsersViewModel}">
            <views:UsersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CurrencyViewModel}">
            <views:CurrencyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ProductViewModel}">
            <views:ProductView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:RateViewModel}">
            <views:RateView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:FeeViewModel}">
            <views:FeeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CommissionViewModel}">
            <views:CommissionView/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation Sidebar -->
        <Border Grid.Column="0" Background="#f0f0f0">
            <StackPanel Margin="10">
                <TextBlock Text="Navigation" FontSize="16" FontWeight="Bold" Margin="0,10,0,20"/>
                <Button Content="Loans"
                        Height="40" Margin="0,5"
                        Command="{Binding NavigateToLoansCommand}"
                        Background="#007acc" Foreground="White"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Retail Accounts"
                        Height="40" Margin="0,5"
                        Command="{Binding NavigateToRetailAccountsCommand}"
                        Background="#007acc" Foreground="White"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Bank Clients"
                        Height="40" Margin="0,5"
                        Command="{Binding NavigateToBankClientsCommand}"
                        Background="#007acc" Foreground="White"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Users"
                        Height="40" Margin="0,5"
                        Command="{Binding NavigateToUsersCommand}"
                        Background="#6f42c1" Foreground="White"
                        HorizontalAlignment="Stretch"/>

                <TextBlock Text="Configuration" FontSize="13" FontWeight="SemiBold" Margin="0,15,0,5" Foreground="#555"/>
                <Button Content="Currencies"
                        Height="40" Margin="0,5"
                        Command="{Binding NavigateToCurrenciesCommand}"
                        Background="#28a745" Foreground="White"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Products"
                        Height="40" Margin="0,5"
                        Command="{Binding NavigateToProductsCommand}"
                        Background="#28a745" Foreground="White"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Rates"
                        Height="40" Margin="0,5"
                        Command="{Binding NavigateToRatesCommand}"
                        Background="#28a745" Foreground="White"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Fees"
                        Height="40" Margin="0,5"
                        Command="{Binding NavigateToFeesCommand}"
                        Background="#28a745" Foreground="White"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Commissions"
                        Height="40" Margin="0,5"
                        Command="{Binding NavigateToCommissionsCommand}"
                        Background="#28a745" Foreground="White"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <!-- Content Area — displays the active ViewModel via DataTemplate above -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
