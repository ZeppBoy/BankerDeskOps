<Window x:Class="BankerDeskOps.Wpf.Views.CreateRepaymentScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Repayment Schedule" Height="961" Width="800"
        ResizeMode="NoResize">
    <Grid Margin="20,20,20,-6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Loan Application Info -->
            <RowDefinition Height="Auto"/>
            <!-- Settings -->
            <RowDefinition Height="Auto"/>
            <!-- Generated Schedule Preview -->
            <RowDefinition Height="*"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Create Repayment Schedule" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Loan Application Info Section -->
        <Border Grid.Row="1" Background="#e8f4fd" Padding="10" Margin="0,0,0,15" BorderBrush="#b3d9ff" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <Label Content="Application ID:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding LoanApplication.Id}" Margin="0,2,0,0"/>

                    <Label Content="Product:" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding LoanApplication.ProductName}" Margin="0,2,0,0"/>

                    <Label Content="Amount:" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding LoanApplication.Amount, StringFormat='{}{0:C2}'}" Margin="0,2,0,0"/>

                    <Label Content="Term (Months):" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding LoanApplication.TermMonths}" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#f9f9f9" Padding="10" BorderBrush="#ddd" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Label Content="Calculated Monthly Payment:"/>
                            <TextBlock Text="{Binding MonthlyPayment, StringFormat='{}{0:C2}'}" 
                                       FontSize="16" FontWeight="Bold" Foreground="#28a745"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <Label Content="Total Number of Payments:"/>
                            <TextBlock Text="{Binding PaymentCount}" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Settings Section -->
        <Border Grid.Row="2" Background="#f9f9f9" Padding="10" Margin="0,0,0,15" BorderBrush="#b3d9ff" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                    <Label Content="First Payment Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker Width="150" SelectedDate="{Binding FirstPaymentDate}"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Generate Schedule" Command="{Binding GenerateScheduleCommand}"
                        Height="30" Padding="20,5" Background="#007bff" Foreground="White"/>
            </Grid>
        </Border>

        <!-- Generated Schedule Preview -->
        <Border Grid.Row="3" Background="#f9f9f9" Padding="10" Margin="0,0,0,15" BorderBrush="#b3d9ff" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Generated Schedule Preview:" FontWeight="Bold" Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding GeneratedSchedule}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow" Margin="0,0,0,-238">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding PaymentNumber}" Width="50"/>
                        <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                        <DataGridTextColumn Header="Principal" Binding="{Binding PrincipalAmount, StringFormat='{}{0:C2}'}" Width="110"/>
                        <DataGridTextColumn Header="Interest" Binding="{Binding InterestAmount, StringFormat='{}{0:C2}'}" Width="110"/>
                        <DataGridTextColumn Header="Total Payment" Binding="{Binding TotalPayment, StringFormat='{}{0:C2}'}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Error Message -->
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="#dc3545" Margin="0,71,0,169" TextWrapping="Wrap" Grid.RowSpan="2"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Create Schedule Entries" Command="{Binding CreateScheduleEntriesCommand}" 
                    Height="35" Padding="25,5" Background="#28a745" Foreground="White" Margin="0,0,10,0"
                    IsDefault="True"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Height="35" Padding="25,5"
                    Background="#6c757d" Foreground="White" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
